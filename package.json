{
  "name": "job-hunter",
  "version": "0.1.0",
  "private": true,
  "description": "Personal job-hunting assistant: watches Djinni/DOU/Robota.ua, scores vacancies and drafts cover letters with Claude; web board for review, Telegram for notifications.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "serve": "node --disable-warning=ExperimentalWarning src/cli.ts serve",
    "scan": "node --disable-warning=ExperimentalWarning src/cli.ts scan",
    "link": "node --disable-warning=ExperimentalWarning src/cli.ts link",
    "stats": "node --disable-warning=ExperimentalWarning src/cli.ts stats",
    "show": "node --disable-warning=ExperimentalWarning src/cli.ts show",
    "why": "node --disable-warning=ExperimentalWarning src/cli.ts why",
    "build": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "test": "node --disable-warning=ExperimentalWarning --test 'tests/**/*.test.ts'",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "fast-xml-parser": "^5.11.2",
    "grammy": "^1.46.0",
    "hono": "^4.13.12",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
